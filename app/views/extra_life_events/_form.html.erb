<%# Event setup. Enabling is only offered once the bot has resolved the Tiltify campaign id (the model enforces it too). %>
<% zones = (["America/Vancouver", "America/Edmonton", "America/Winnipeg", "America/Toronto", "America/Halifax",
             "America/Los_Angeles", "America/Denver", "America/Chicago", "America/New_York", "UTC"] | [event.time_zone].compact) %>
<%= form_with model: event, url: (event.persisted? ? bot_extra_life_event_path(bot, event) : bot_extra_life_events_path(bot)), local: true, data: { turbo: false } do |f| %>
  <div class="extra-life-event-form">
    <div class="w95-field">
      <%= f.label :name, 'Event name' %>
      <%= f.text_field :name, required: true, placeholder: 'Extra Life 2026' %>
    </div>
    <div class="w95-field">
      <%= f.label :broadcaster_login, 'Broadcaster (Twitch login)' %>
      <%= f.text_field :broadcaster_login, value: event.broadcaster_login || bot.channel, required: true %>
      <span class="w95-hint">Checked with Twitch on save. The broadcaster can never win.</span>
    </div>
    <div class="w95-field">
      <%= f.label :tiltify_campaign_url, 'Tiltify campaign URL' %>
      <%= f.text_field :tiltify_campaign_url, placeholder: 'https://tiltify.com/@yourname/your-campaign' %>
      <span class="w95-hint">Must start with https://tiltify.com/. The bot resolves it to the campaign id within about a minute.</span>
    </div>
    <% if event.persisted? %>
      <div class="w95-field">
        <%= f.label :tiltify_campaign_id, 'Tiltify campaign id' %>
        <%= f.text_field :tiltify_campaign_id, placeholder: 'filled in by the bot' %>
        <span class="w95-hint">Optional: paste the campaign UUID yourself if you have it.</span>
      </div>
    <% end %>
    <div class="w95-field">
      <%= f.label :stream_start_local, 'Stream start' %>
      <%= f.datetime_local_field :stream_start_local, value: event.stream_start_local&.strftime("%Y-%m-%dT%H:%M"), required: event.new_record? %>
      <span class="w95-hint">Local time in the zone below. Only donations completed at or after this count.</span>
    </div>
    <div class="w95-field">
      <%= f.label :donor_tickets_per_dollar, 'Donor tickets per $1' %>
      <%= f.number_field :donor_tickets_per_dollar, min: 0, max: 1000, step: 1, placeholder: '10' %>
      <span class="w95-hint">Default 10: donors get 10 tickets per dollar, all their donations added up (rounded down, at least 1). Set 0 or blank for 1 ticket per donor. A chat entry is always 1 ticket.</span>
    </div>
    <div class="w95-field">
      <%= f.label :time_zone, 'Time zone' %>
      <%= f.select :time_zone, zones, selected: event.time_zone.presence || "America/Vancouver" %>
    </div>
    <% if event.persisted? %>
      <div class="w95-field">
        <span></span>
        <label>
          <%= f.check_box :enabled, disabled: event.tiltify_campaign_id.blank? && !event.enabled %>
          Enabled (chat entry, donation sync and draws)
        </label>
        <% if event.tiltify_campaign_id.blank? && !event.enabled %>
          <span class="w95-hint">Available once the Tiltify campaign is resolved.</span>
        <% end %>
      </div>
    <% else %>
      <p class="w95-hint" style="margin-left:0">The event starts disabled. Open it after creating to check the campaign, add prizes and enable it.</p>
    <% end %>
    <div class="w95-actions">
      <%= f.submit event.persisted? ? "Save settings" : "Create event", class: 'w95-btn-default' %>
    </div>
  </div>
<% end %>
