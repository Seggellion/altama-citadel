<% if giveaway.event_mode? %>
  <% attempt = giveaway.live_draw_attempt %>
  <h3>Tickets (Extra Life event: <%= link_to giveaway.extra_life_event.name, bot_extra_life_event_path(giveaway.bot_id, giveaway.extra_life_event) %>)</h3>
  <% if attempt&.status == "finalized" %>
    <p>Drawn: <%= attempt.result == "winner" ? attempt.winner_account&.login : "no eligible entries" %> (final snapshot below)</p>
    <%= render "extra_life_events/pool_table", rows: (attempt.pool || []), snapshot: true %>
  <% else %>
    <%= render "extra_life_events/pool_table", rows: giveaway.event_pool, snapshot: false %>
  <% end %>
<% else %>
<h3>Participants- <%= giveaway.giveaway_users.count %></h3>
<% if giveaway.winner %>
Winner: <%= giveaway.winner %> 
<% end %>

<table style="width:500px;">
<tr>
<th>
joinDate
</th>
<th>
username
</th>
<th>
aec
</th>
<th>
karma
</th>
<th>
fame
</th>
</tr>
<% giveaway.giveaway_users.each do |user| %>
  <tr>
  <td>
  <p><%= user.created_at.strftime("%A %d, %B") %></p>
  </td>
  <% if user.user %>
  <td>
  <p><%= user.user.username %></p>
  </td>
  <td>
  <p><%= user.user.aec %></p>
  </td>
  <td>
  <p><%= user.user.karma %></p>
  </td>
  <td>
  <p><%= user.user.fame %></p>
  </td>
  <% end %>
  </tr>
<% end %>
</table>
<% end %>
