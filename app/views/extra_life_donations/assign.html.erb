<% tz = @event.time_zone %>
<%= render layout: 'extra_life_events/window', locals: { title: "Assign donation — #{@event.name}", close_path: bot_extra_life_event_path(@bot, @event, tab: 'donations') } do %>
  <fieldset class="w95-group">
    <legend>Step 1 of 2: check the Twitch account</legend>
    <table class="w95-table">
      <tr><td>Donation</td><td><code><%= @donation.external_id.first(8) %></code></td></tr>
      <tr><td>Donor name on Tiltify</td><td><strong><%= @donation.donor_name %></strong></td></tr>
      <tr><td>Completed</td><td><%= event_time(@event, @donation.completed_at, '%Y-%m-%d %-I:%M %p %Z') %></td></tr>
      <tr><td>Current match</td><td><%= @donation.manual? ? "MANUAL" : @donation.match_outcome %></td></tr>
    </table>

    <% if @lookup_error %>
      <div class="w95-message alert"><span class="w95-icon">!</span><div>Twitch could not be reached (<%= @lookup_error %>). Nothing was changed; try again.</div></div>
    <% elsif @not_found %>
      <div class="w95-message alert"><span class="w95-icon">!</span><div>"<%= @login %>" is not a Twitch account (or not a valid login). Nothing was changed.</div></div>
    <% end %>

    <%= form_with url: assign_bot_extra_life_event_donation_path(@bot, @event, @donation), method: :get, local: true, data: { turbo: false } do |f| %>
      <div class="w95-toolbar"><span>Twitch login:</span> <%= f.text_field :login, value: @login, required: true %> <%= f.submit "Look up", class: 'w95-btn-small' %></div>
    <% end %>
  </fieldset>

  <% if @account %>
    <fieldset class="w95-group">
      <legend>Step 2 of 2: confirm</legend>
      <p>Twitch account: <strong><%= @account.login %></strong> (display name <%= @account.display_name %>), Twitch id <strong><%= @account.id %></strong>.</p>
      <% if @account.id == @event.broadcaster_twitch_id %>
        <div class="w95-message alert"><span class="w95-icon">!</span><div>This is the broadcaster, who is excluded and cannot receive donor tickets.</div></div>
      <% else %>
        <%= form_with url: assign_bot_extra_life_event_donation_path(@bot, @event, @donation), method: :post, local: true, data: { turbo: false } do |f| %>
          <%= f.hidden_field :twitch_user_id, value: @account.id %>
          <div class="w95-field">
            <%= f.label :reason, 'Reason (required)' %>
            <%= f.text_field :reason, required: true, placeholder: 'e.g. donor confirmed their Twitch name in chat' %>
          </div>
          <div class="w95-actions">
            <%= link_to 'Cancel', bot_extra_life_event_path(@bot, @event, tab: 'donations'), class: 'w95-btn', data: { turbo: false } %>
            <%= f.submit "Give this donor ticket to #{@account.login}", class: 'w95-btn-default' %>
          </div>
        <% end %>
        <p><small>Applies to this event's prizes that have not been drawn. Drawn prizes never change. The assignment is recorded with your name.</small></p>
      <% end %>
    </fieldset>
  <% end %>
<% end %>
